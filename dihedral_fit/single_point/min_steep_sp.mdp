; Single-point energy: zero steps of minimisation, so the energy that mdrun
; prints belongs to the structure exactly as it was read in.
; No "define" here, so the dihedral restraints stay switched off.
integrator               = steep
emtol                    = 10.0
emstep                   = 0.0001
nsteps                   = 0

nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstxout-compressed       = 0

cutoff-scheme            = Verlet
nstlist                  = 1
ns_type                  = grid
coulombtype              = Cutoff
rcoulomb                 = 1.0
rvdw                     = 1.0
pbc                      = xyz
