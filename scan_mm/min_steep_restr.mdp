; Restrained minimisation of one point of the torsional scan.
; -DDIHRES switches on the [ dihedral_restraints ] block of the topology,
; which holds the torsion being scanned and the one kept frozen.
define                   = -DDIHRES

integrator               = steep
emtol                    = 10.0
emstep                   = 0.0001
nsteps                   = 50000

nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstxout-compressed       = 0

cutoff-scheme            = Verlet
nstlist                  = 1
ns_type                  = grid
coulombtype              = Cutoff
rcoulomb                 = 1.0
rvdw                     = 1.0
pbc                      = xyz
